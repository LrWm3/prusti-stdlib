predicate Slot(x: Ref)
predicate Element(x: Ref)

method convert(x: Ref)
  requires acc(Slot(x))
  ensures acc(Slot(x))

method package_without_frame(s: Ref, element: Ref)
  requires acc(Slot(s))
  ensures acc(Slot(s))
  ensures acc(Element(element)) --* acc(Element(element))
{
  package acc(Element(element)) --* acc(Element(element)) {
    convert(s)
  }
}
