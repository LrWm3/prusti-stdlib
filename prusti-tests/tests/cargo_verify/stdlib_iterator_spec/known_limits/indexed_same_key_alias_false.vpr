field value: Int
predicate cell(r: Ref) { acc(r.value) }
function snapshot(r: Ref): Int
  requires acc(cell(r), wildcard)
{ unfolding acc(cell(r), wildcard) in r.value }
predicate indexed(i: Int, path: Seq[Int], r: Ref) { acc(cell(r)) }

method checked_alias(r: Ref, i: Int)
  requires acc(indexed(i, Seq(1, 0), r))
{
  var j: Int
  var path: Seq[Int]
  j := i
  path := Seq(1, 0)
  package acc(indexed(i, Seq(1, 0), r)) --*
    acc(cell(r)) && snapshot(r) == old[lhs](unfolding acc(indexed(i, Seq(1, 0), r)) in snapshot(r)) {
    var current: Int
    current := (unfolding acc(indexed(i, Seq(1, 0), r)) in snapshot(r))
    assert j == i && path == Seq(1, 0)
    assert (unfolding acc(indexed(j, path, r)) in snapshot(r)) == current
    unfold acc(indexed(j, path, r))
    assert snapshot(r) == current + 1
  }
}
