field link: Ref
field value: Int
predicate storage(owner: Ref) { acc(owner.link, write) }
predicate resource(cell: Ref) { acc(cell.value, write) }
function pointer(owner: Ref): Ref
  requires acc(storage(owner), write)
{ unfolding acc(storage(owner), write) in owner.link }
function contents(cell: Ref): Int
  requires acc(resource(cell), write)
{ unfolding acc(resource(cell), write) in cell.value }
// This candidate deliberately omits the current owner's resource at expiry.
method insufficient_outer(owner: Ref, entry: Ref)
  requires acc(storage(owner), write) && pointer(owner) == entry
  requires acc(resource(entry), write)
  ensures acc(storage(owner), write) && pointer(owner) == entry
  ensures acc(resource(entry), write)
  ensures (acc(storage(owner), write) && acc(resource(entry), write)) --* (acc(storage(owner), write) &&
    (let current == (pointer(owner)) in
      (acc(resource(current), write) &&
      (acc(resource(current), write) --* acc(resource(entry), write)))))
{
  package true --* (acc(storage(owner), write) && pointer(owner) == entry && acc(resource(entry), write)) {}
  package (acc(storage(owner), write) && acc(resource(entry), write)) --* (acc(storage(owner), write) &&
    (let current == (pointer(owner)) in
      (acc(resource(current), write) &&
      (acc(resource(current), write) --* acc(resource(entry), write))))) {
    var current: Ref := pointer(owner)
    package true --* acc(resource(current), write) {}
    package acc(resource(current), write) --* acc(resource(entry), write) {}
    apply true --* acc(resource(current), write)
  }
  apply true --* (acc(storage(owner), write) && pointer(owner) == entry && acc(resource(entry), write))
}
