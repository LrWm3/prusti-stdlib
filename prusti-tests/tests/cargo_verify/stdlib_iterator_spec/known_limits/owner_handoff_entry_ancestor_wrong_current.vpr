// Checked model: freeze the ancestor slot at entry, observe its owner now.
field link: Ref
field value: Int
predicate storage(owner: Ref) { acc(owner.link, write) }
predicate resource(cell: Ref) { acc(cell.value, write) }
function pointer(owner: Ref): Ref
  requires acc(storage(owner), write)
{ unfolding acc(storage(owner), write) in owner.link }
function contents(cell: Ref): Int
  requires acc(resource(cell), write)
{ unfolding acc(resource(cell), write) in cell.value }
method change(slot: Ref)
  requires acc(slot.link, write)
  requires slot.link != null
  requires acc(storage(slot.link), write)
  requires acc(resource(pointer(slot.link)), write)
  ensures acc(slot.link, write) && slot.link == null
  ensures acc(storage(old(slot.link)), write)
  ensures acc(resource(pointer(old(slot.link))), write)
  ensures contents(pointer(old(slot.link))) == 7
  ensures (let before == (old(pointer(slot.link))) in
    (let saved == (old(contents(pointer(slot.link)))) in
    (let current == (pointer(old(slot.link))) in
    (acc(resource(current), write) --*
      (acc(resource(before), write) && contents(before) == saved)))))
{
  var owner: Ref := slot.link
  var before: Ref := pointer(owner)
  var saved: Int := contents(before)
  var replacement: Ref
  replacement := new(value)
  replacement.value := 7
  fold acc(resource(replacement), write)
  unfold acc(storage(owner), write)
  owner.link := replacement
  fold acc(storage(owner), write)
  slot.link := null
  package acc(resource(replacement), write) --*
    (acc(resource(before), write) && contents(before) == saved) {
  }
}
method client(slot: Ref)
  requires acc(slot.link, write)
  requires slot.link != null
  requires acc(storage(slot.link), write)
  requires acc(resource(pointer(slot.link)), write)
{
  var owner: Ref := slot.link
  var before: Ref := pointer(owner)
  var saved: Int := contents(before)
  change(slot)
  assert slot.link == null
  var current: Ref := pointer(owner)
  assert contents(current) == 7
  unfold acc(resource(current), write)
  current.value := 13
  fold acc(resource(current), write)
  assert contents(current) == 14
  apply acc(resource(current), write) --*
    (acc(resource(before), write) && contents(before) == saved)
  assert contents(before) == saved
}
